CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER = NO
GCC_PREPROCESSOR_DEFINITIONS = $(inherited) COCOAPODS=1
HEADER_SEARCH_PATHS = $(inherited) "${PODS_ROOT}/Headers/Public" "${PODS_ROOT}/Headers/Public/AFNetworking" "${PODS_ROOT}/Headers/Public/CTMediator" "${PODS_ROOT}/Headers/Public/FPBaseClass" "${PODS_ROOT}/Headers/Public/FPCategory" "${PODS_ROOT}/Headers/Public/FPCore" "${PODS_ROOT}/Headers/Public/FPGood" "${PODS_ROOT}/Headers/Public/FPHome" "${PODS_ROOT}/Headers/Public/FPLogin" "${PODS_ROOT}/Headers/Public/FPMy" "${PODS_ROOT}/Headers/Public/FPNetwork" "${PODS_ROOT}/Headers/Public/FPRouter" "${PODS_ROOT}/Headers/Public/MBProgressHUD" "${PODS_ROOT}/Headers/Public/MJExtension" "${PODS_ROOT}/Headers/Public/MJRefresh" "${PODS_ROOT}/Headers/Public/Masonry" "${PODS_ROOT}/Headers/Public/SDCycleScrollView" "${PODS_ROOT}/Headers/Public/SDWebImage" "${PODS_ROOT}/Headers/Public/TMUtils" "${PODS_ROOT}/Headers/Public/YTKNetwork" "${PODS_ROOT}/Headers/Public/YYText"
LIBRARY_SEARCH_PATHS = $(inherited) "${PODS_CONFIGURATION_BUILD_DIR}/AFNetworking" "${PODS_CONFIGURATION_BUILD_DIR}/CTMediator" "${PODS_CONFIGURATION_BUILD_DIR}/FPBaseClass" "${PODS_CONFIGURATION_BUILD_DIR}/FPCategory" "${PODS_CONFIGURATION_BUILD_DIR}/FPCore" "${PODS_CONFIGURATION_BUILD_DIR}/FPGood" "${PODS_CONFIGURATION_BUILD_DIR}/FPHome" "${PODS_CONFIGURATION_BUILD_DIR}/FPLogin" "${PODS_CONFIGURATION_BUILD_DIR}/FPMy" "${PODS_CONFIGURATION_BUILD_DIR}/FPNetwork" "${PODS_CONFIGURATION_BUILD_DIR}/FPRouter" "${PODS_CONFIGURATION_BUILD_DIR}/MBProgressHUD" "${PODS_CONFIGURATION_BUILD_DIR}/MJExtension" "${PODS_CONFIGURATION_BUILD_DIR}/MJRefresh" "${PODS_CONFIGURATION_BUILD_DIR}/Masonry" "${PODS_CONFIGURATION_BUILD_DIR}/SDCycleScrollView" "${PODS_CONFIGURATION_BUILD_DIR}/SDWebImage" "${PODS_CONFIGURATION_BUILD_DIR}/TMUtils" "${PODS_CONFIGURATION_BUILD_DIR}/YTKNetwork" "${PODS_CONFIGURATION_BUILD_DIR}/YYText"
OTHER_LDFLAGS = $(inherited) -ObjC -l"AFNetworking" -l"CTMediator" -l"FPBaseClass" -l"FPCategory" -l"FPCore" -l"FPGood" -l"FPHome" -l"FPLogin" -l"FPMy" -l"FPNetwork" -l"FPRouter" -l"MBProgressHUD" -l"MJExtension" -l"MJRefresh" -l"Masonry" -l"SDCycleScrollView" -l"SDWebImage" -l"TMUtils" -l"YTKNetwork" -l"YYText" -framework "Accelerate" -framework "CFNetwork" -framework "CoreFoundation" -framework "CoreGraphics" -framework "CoreText" -framework "Foundation" -framework "ImageIO" -framework "MobileCoreServices" -framework "QuartzCore" -framework "UIKit"
OTHER_MODULE_VERIFIER_FLAGS = $(inherited) "-F${PODS_CONFIGURATION_BUILD_DIR}/AFNetworking" "-F${PODS_CONFIGURATION_BUILD_DIR}/CTMediator" "-F${PODS_CONFIGURATION_BUILD_DIR}/FPBaseClass" "-F${PODS_CONFIGURATION_BUILD_DIR}/FPCategory" "-F${PODS_CONFIGURATION_BUILD_DIR}/FPCore" "-F${PODS_CONFIGURATION_BUILD_DIR}/FPGood" "-F${PODS_CONFIGURATION_BUILD_DIR}/FPHome" "-F${PODS_CONFIGURATION_BUILD_DIR}/FPLogin" "-F${PODS_CONFIGURATION_BUILD_DIR}/FPMy" "-F${PODS_CONFIGURATION_BUILD_DIR}/FPNetwork" "-F${PODS_CONFIGURATION_BUILD_DIR}/FPRouter" "-F${PODS_CONFIGURATION_BUILD_DIR}/MBProgressHUD" "-F${PODS_CONFIGURATION_BUILD_DIR}/MJExtension" "-F${PODS_CONFIGURATION_BUILD_DIR}/MJRefresh" "-F${PODS_CONFIGURATION_BUILD_DIR}/Masonry" "-F${PODS_CONFIGURATION_BUILD_DIR}/SDCycleScrollView" "-F${PODS_CONFIGURATION_BUILD_DIR}/SDWebImage" "-F${PODS_CONFIGURATION_BUILD_DIR}/TMUtils" "-F${PODS_CONFIGURATION_BUILD_DIR}/YTKNetwork" "-F${PODS_CONFIGURATION_BUILD_DIR}/YYText"
PODS_BUILD_DIR = ${BUILD_DIR}
PODS_CONFIGURATION_BUILD_DIR = ${PODS_BUILD_DIR}/$(CONFIGURATION)$(EFFECTIVE_PLATFORM_NAME)
PODS_PODFILE_DIR_PATH = ${SRCROOT}/.
PODS_ROOT = ${SRCROOT}/Pods
PODS_XCFRAMEWORKS_BUILD_DIR = $(PODS_CONFIGURATION_BUILD_DIR)/XCFrameworkIntermediates
USE_RECURSIVE_SCRIPT_INPUTS_IN_SCRIPT_PHASES = YES
